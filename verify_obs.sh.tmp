#!/bin/bash
echo "=== sleep 25s for services to emit ==="
sleep 25

echo "=== 1. SEQ: log count ==="
curl -s --max-time 8 "http://127.0.0.1:5341/api/events?count=true" 2>&1 | head -c 200
echo
echo "=== 1b. SEQ: recent log sources ==="
curl -s --max-time 8 "http://127.0.0.1:5341/api/resources" 2>&1 | head -c 500
echo

echo "=== 2. JAEGER: services list ==="
curl -s --max-time 8 "http://127.0.0.1:16686/api/services" 2>&1 | head -c 500
echo

echo "=== 3. PROMETHEUS: targets ==="
curl -s --max-time 8 "http://127.0.0.1:9091/api/v1/targets" 2>&1 | python3 -c "
import json,sys
d=json.load(sys.stdin)
for t in d.get('data',{}).get('activeTargets',[]):
    job=t.get('labels',{}).get('job','?')
    health=t.get('health','?')
    err=t.get('lastError','')[:60]
    print(f'  {job:25s} {health:8s} {err}')
"
echo

echo "=== 4. GRAFANA: health ==="
curl -s --max-time 8 -u admin:admin "http://127.0.0.1:3100/api/health" 2>&1 | head -c 200
echo
